<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">

    <TextView android:id="@+id/ctx" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/mint" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
        android:text="Cue" />

    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="@color/text" android:textSize="19sp" android:textStyle="bold"
        android:maxLines="2" android:ellipsize="end" android:text="Loading…" />

    <TextView android:id="@+id/body" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/dim" android:textSize="13sp" android:maxLines="2" android:ellipsize="end"
        android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/primary" android:layout_width="wrap_content" android:layout_height="36dp"
            android:background="@drawable/btn_primary" android:textColor="@color/ink" android:textSize="14sp"
            android:textStyle="bold" android:paddingStart="18dp" android:paddingEnd="18dp" android:minWidth="0dp"
            android:minHeight="0dp" android:textAllCaps="false" android:text="Done" />
        <Button android:id="@+id/skip" android:layout_width="wrap_content" android:layout_height="36dp"
            android:layout_marginStart="8dp" android:background="@drawable/btn_ghost" android:textColor="@color/text"
            android:textSize="14sp" android:paddingStart="16dp" android:paddingEnd="16dp" android:minWidth="0dp"
            android:minHeight="0dp" android:textAllCaps="false" android:text="Not now" />
        <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton android:id="@+id/add" android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/btn_ghost" android:src="@drawable/ic_add" android:contentDescription="Capture" />
    </LinearLayout>

    <TextView android:id="@+id/today_head" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textColor="@color/dim" android:textSize="12sp" android:visibility="gone" />
    <TextView android:id="@+id/t0" style="@style/WidgetRow" />
    <TextView android:id="@+id/t1" style="@style/WidgetRow" />
    <TextView android:id="@+id/t2" style="@style/WidgetRow" />
    <TextView android:id="@+id/t3" style="@style/WidgetRow" />
    <TextView android:id="@+id/t4" style="@style/WidgetRow" />
</LinearLayout>
